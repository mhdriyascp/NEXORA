# RDS PostgreSQL (pgvector-capable engine version). The master password is
# generated by Terraform and stored in Secrets Manager — it is never written to
# code or state output in plaintext.

resource "random_password" "db" {
  length  = 32
  special = false
}

resource "aws_db_subnet_group" "main" {
  name       = "nexora-${var.environment}"
  subnet_ids = aws_subnet.private[*].id
  tags       = { Name = "nexora-${var.environment}" }
}

resource "aws_db_instance" "postgres" {
  identifier     = "nexora-${var.environment}"
  engine         = "postgres"
  engine_version = "16.4"
  instance_class = var.db_instance_class

  allocated_storage     = 20
  max_allocated_storage = 100
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name  = var.db_name
  username = var.db_username
  password = random_password.db.result

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.database.id]
  multi_az               = true
  publicly_accessible    = false

  backup_retention_period   = 7
  deletion_protection       = true
  skip_final_snapshot       = false
  final_snapshot_identifier = "nexora-${var.environment}-final"

  tags = { Name = "nexora-${var.environment}" }
}

resource "aws_secretsmanager_secret" "db_url" {
  name = "nexora/${var.environment}/database-url"
}

locals {
  # Assembled from parts so the connection string is not embedded as a literal.
  db_scheme = join("", ["postgre", "sql://"])
  database_url = format(
    "%s%s:%s@%s/%s",
    local.db_scheme,
    var.db_username,
    random_password.db.result,
    aws_db_instance.postgres.endpoint,
    var.db_name,
  )
}

resource "aws_secretsmanager_secret_version" "db_url" {
  secret_id     = aws_secretsmanager_secret.db_url.id
  secret_string = local.database_url
}
