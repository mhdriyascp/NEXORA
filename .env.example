# NEXORA — Environment Configuration Example
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in local values:  cp .env.example .env
#
# This file documents the configuration variables the platform will use.
# It contains PLACEHOLDER values only. NEVER commit real secrets.
# Production secrets are managed via AWS Secrets Manager (or equivalent).
# -----------------------------------------------------------------------------

# ---- Core / Runtime ---------------------------------------------------------
NODE_ENV=development
# Application version surfaced in health checks.
APP_VERSION=0.1.0
# Log verbosity for structured logs (trace|debug|info|warn|error).
LOG_LEVEL=info

# ---- Service Ports ----------------------------------------------------------
API_PORT=4000
WORKER_HEALTH_PORT=4100
# Allowed browser origin for API CORS.
WEB_ORIGIN=http://localhost:3000

# ---- Database (PostgreSQL + pgvector) ---------------------------------------
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/nexora
# Used by docker-compose to provision the Postgres container.
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora
POSTGRES_DB=nexora

# ---- Cache / Queue (Redis) --------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- Authentication ---------------------------------------------------------
# Use a long, random value in real environments. Do NOT reuse this placeholder.
JWT_SECRET=change_me_use_a_long_random_secret

# ---- AWS / Object Storage ---------------------------------------------------
AWS_REGION=us-east-1
S3_BUCKET=nexora-dev-documents
# For local dev you may point these at a local S3-compatible service.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- LLM Provider (abstraction) ---------------------------------------------
# LLM_PROVIDER selects the provider implementation: openai | anthropic | local
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Embeddings -------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ---- AI Safety Limits -------------------------------------------------------
AI_MAX_TOKENS=4096
# AI_MAX_COST is a per-request budget guard (in your chosen currency unit).
AI_MAX_COST=1.00

# ---- Frontend ---------------------------------------------------------------
# Public base URL the Next.js app uses to reach the NestJS API.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ---- Internal Service URLs (server-side only) -------------------------------
# NestJS AI Gateway → FastAPI AI service (never exposed to the browser).
AI_SERVICE_URL=http://localhost:8000
# Shared internal credential for gateway ↔ AI service authentication.
AI_SERVICE_INTERNAL_TOKEN=change_me_internal_service_token
